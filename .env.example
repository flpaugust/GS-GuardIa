# Modelo de configuração local do GuardIão (copie para `.env` e preencha com suas chaves)
# O arquivo `.env` está no `.gitignore` e nunca deve ser enviado para o GitHub.

# Firebase Console -> Configurações do Projeto -> Seus aplicativos -> Web (</>)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Opcional: chave gratuita do Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# Identificador padrão do paciente monitorado
PATIENT_ID=paciente_01
